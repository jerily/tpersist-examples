{
  "name": "tpersist-examples",
  "version": "0.1.8",
  "license": "MIT",
  "dependencies": {
    "tpersist": "^0.1.8",
    "tpersist-sqlite": "^0.1.8"
  },
  "build": {
    "default": [
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
